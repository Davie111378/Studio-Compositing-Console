{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ExecutionPlanDAG",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "intent",
    "nodes"
  ],
  "properties": {
    "intent": {
      "type": "string"
    },
    "nodes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 10,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "tool",
          "params"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^n[0-9]+$"
          },
          "tool": {
            "type": "string",
            "enum": [
              "T01_matting",
              "T02_background_generate",
              "T03_lighting_estimate",
              "T04_relight",
              "T05_shadow_generate",
              "T06_harmonize",
              "T07_enhance",
              "T08_export"
            ]
          },
          "params": {
            "type": "object"
          },
          "depends_on": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^n[0-9]+$"
            }
          }
        }
      }
    },
    "outputs": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^n[0-9]+$"
      }
    }
  }
}