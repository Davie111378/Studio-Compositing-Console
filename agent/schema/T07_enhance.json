{
  "id": "T07",
  "name": "enhance",
  "version": "0.5",
  "b_mapping": "fx_tool 兜底 (接口文档 §2: T07 用 fx 兜底): depth_blur 景深 + 可选 USM 锐化",
  "desc": "增强: 景深虚化/锐化/颗粒 (fx 兜底实现, version v0.5)",
  "quality_tiers": {
    "draft": "depth_blur 0.3",
    "normal": "depth_blur 0.45",
    "fine": "depth_blur 0.45 + 锐化"
  },
  "input": {
    "$schema": "http://json-schema.org/draft-07/schema#",
    "additionalProperties": false,
    "type": "object",
    "properties": {
      "image_path": {
        "type": "string"
      },
      "mode": {
        "type": "string",
        "enum": [
          "depth_blur",
          "sharpen",
          "grain"
        ],
        "default": "depth_blur"
      },
      "intensity": {
        "type": "number"
      },
      "quality": {
        "type": "string",
        "enum": [
          "draft",
          "normal",
          "fine"
        ],
        "default": "draft"
      }
    },
    "required": [
      "image_path"
    ]
  },
  "output": {
    "type": "object",
    "properties": {
      "enhanced_path": {
        "type": "string"
      }
    },
    "required": [
      "enhanced_path"
    ]
  },
  "errors": [
    {
      "code": "E_INPUT_MISSING",
      "message": "输入缺失",
      "retryable": false
    },
    {
      "code": "E_ENHANCE_FAIL",
      "message": "增强失败",
      "retryable": true
    }
  ],
  "latency_budget_ms": {
    "draft": 200,
    "fine": 400
  }
}