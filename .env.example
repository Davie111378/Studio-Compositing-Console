# ============================================================
# 环境配置模板 —— 复制本文件为 .env 并填入你自己的密钥
# 注意：.env 严禁提交进 Git（已在 .gitignore 排除）
#       若仓库历史中曾出现真实密钥，请立即去对应平台吊销/轮换！
# ============================================================

# 默认 LLM 后端：agnes | qwen
LLM_PROVIDER=agnes

# ---- agnes 后端 ----
AGNES_API_KEY=sk-your-agnes-key-here
AGNES_BASE_URL=https://your-agnes-endpoint
AGNES_CHAT_MODEL=agnes-3.0-flash
AGNES_VL_MODEL=agnes-vl-xxx
AGNES_IMAGE_MODEL=agnes-image-xxx

# ---- qwen 后端 ----
QWEN_API_KEY=sk-your-qwen-key-here
QWEN_BASE_URL=https://your-qwen-endpoint
QWEN_CHAT_MODEL=qwen-flash
QWEN_VL_MODEL=qwen-vl-max
QWEN_IMAGE_MODEL=qwen-image-xxx
